FROM node:24 AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY artifacts/lastrocapital/package.json ./artifacts/lastrocapital/
RUN pnpm install --frozen-lockfile

FROM deps AS builder
ARG VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
COPY lib/ ./lib/
COPY artifacts/lastrocapital/ ./artifacts/lastrocapital/
RUN pnpm --filter @workspace/api-zod run build 2>/dev/null || true
RUN pnpm --filter @workspace/api-client-react run build 2>/dev/null || true
RUN PORT=3000 BASE_PATH=/ pnpm --filter @workspace/lastrocapital run build

FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/lastrocapital/dist/public /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
