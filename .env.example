# =============================================================================
# LastroCapital — Variáveis de Ambiente para Produção
# Copie este arquivo para .env e preencha os valores reais
# =============================================================================

# ---------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://lastrocapital:SUA_SENHA@localhost:5432/lastrocapital

# ---------------------------------------------------------------------------
# Clerk — Autenticação
# Crie uma conta em https://clerk.com e um novo aplicativo
# Em "Domains" do Clerk dashboard, adicione: lastrocapital.online
# Em "API Keys", copie as chaves abaixo
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY=cole_sua_clerk_secret_key_aqui
CLERK_PUBLISHABLE_KEY=cole_sua_clerk_publishable_key_aqui
VITE_CLERK_PUBLISHABLE_KEY=cole_sua_clerk_publishable_key_aqui

# ---------------------------------------------------------------------------
# AbacatePay — Pagamentos PIX
# Crie uma conta em https://abacatepay.com e copie as chaves
# Configure o webhook para: https://lastrocapital.online/api/webhooks/abacatepay
# ---------------------------------------------------------------------------
ABACATEPAY_API_KEY=cole_sua_abacatepay_api_key_aqui
ABACATEPAY_WEBHOOK_SECRET=cole_seu_webhook_secret_aqui

# ---------------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------------
NODE_ENV=production
