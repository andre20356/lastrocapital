FROM node:24 AS base
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY lib/api-spec/package.json ./lib/api-spec/
COPY lib/api-zod/package.json ./lib/api-zod/
COPY lib/api-client-react/package.json ./lib/api-client-react/
COPY lib/db/package.json ./lib/db/
COPY artifacts/admin-panel/package.json ./artifacts/admin-panel/
RUN pnpm install --frozen-lockfile --ignore-scripts && pnpm rebuild rollup 2>/dev/null || true

FROM deps AS builder
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_API_URL
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_API_URL=$VITE_API_URL
COPY tsconfig.base.json tsconfig.json ./
COPY artifacts/admin-panel/ ./artifacts/admin-panel/
RUN pnpm --filter @workspace/admin-panel run build

FROM nginx:alpine AS runner
COPY --from=builder /app/artifacts/admin-panel/dist/public /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
